Options -Indexes

# Bloquear acceso directo a carpetas sensibles (dumps de BD, backups, logs)
RewriteEngine On
RewriteRule ^(sql|sql_back|backups|logs)(/|$) - [F,L]

# Bloquear por extension en cualquier ruta (dumps, configs, backups sueltos)
<FilesMatch "\.(sql|sql\.gz|log)$">
    Require all denied
</FilesMatch>

# If the request is for an existing file or directory, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Portal cliente URL corta: /creditos/p/TOKEN
RewriteRule ^p/([A-Z0-9]+)/?$ clientes/portal.php?token=$1 [L,QSA]

# Add .php extension if the request has no extension and the .php file exists
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
